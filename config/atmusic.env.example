# Non-secret settings of the atmusic Node host (ADR 0005 §3.8, §14.1).
#
# Copy to ~/.config/atmusic/atmusic.env; the systemd user unit reads it with
# EnvironmentFile=. systemd itself sets STATE_DIRECTORY, XDG_RUNTIME_DIR and
# CREDENTIALS_DIRECTORY. Secrets never go here: they are one JSON document
# (shape: config/secrets.example.json; generate it with
# `npx tsx scripts/admin/gen-secrets.ts`) that the unit loads as the encrypted
# credential "secrets" (ADR §14.2).
#
# No variable relaxes a rule: the public origin and every upstream are https
# on a DNS name with the default port, and the listener is loopback only.
#
# Never set here (the unit unsets them, and the server exits 78 naming the
# variable if one reaches it): NODE_OPTIONS, NODE_TLS_REJECT_UNAUTHORIZED,
# NODE_EXTRA_CA_CERTS, NODE_USE_ENV_PROXY, NODE_PATH, HTTP_PROXY, HTTPS_PROXY,
# NO_PROXY and ALL_PROXY (either case), SSL_CERT_FILE, SSL_CERT_DIR. The
# Workers-era PLAN and DO_LOCATION_HINT, and INGEST_MODE=pulse, are refused.
#
# Every assignment below is commented out: uncomment the required ones and
# fill them in. (Until the Workers entry is retired (ADR 0005 §2.2, N7-01),
# that entry's local secrets still live in worker/.dev.vars, copied from
# worker/.dev.vars.example; the Node host never reads it.)

# --- Required (uncomment) ------------------------------------------------

# The public https origin; the OAuth client_id is
# <origin>/oauth/client-metadata.json and must never change once users sign in.
#ATMUSIC_PUBLIC_ORIGIN=https://music.214510.xyz

# The header that carries the client IP from the proxy in front of the port:
# cf-connecting-ip | x-forwarded-for | x-real-ip | none. No default: the right
# value depends on how traffic reaches 127.2.0.1:8888 (docs/deploy/exposure.md).
#ATMUSIC_CLIENT_IP_HEADER=

# Who may sign in while ATMUSIC_SIGNIN_POLICY is allowlist (the default):
# comma-separated did:plc / did:web DIDs. Required and non-empty then.
#ATMUSIC_SIGNIN_DIDS=

# Lexicon namespace (the namespace gate). Empty disables ingestion and
# publication. NAMESPACE_OWNERSHIP_REF stays empty until the ownership
# evidence (the _lexicon TXT record) exists.
#LEXICON_PREFIX=dev.pythonplayer123.music
#NAMESPACE_OWNERSHIP_REF=

# Jetstream hosts (wss://, rotated on reconnect), the cursor age that triggers
# gap recovery, and the relay used for discovery.
#JETSTREAM_URLS=wss://jetstream.us-east.bsky.network,wss://jetstream.us-west.bsky.network
#JETSTREAM_LOOKBACK_HOURS=24
#RELAY_URL=https://relay1.us-east.bsky.network

# --- Defaults (uncomment to change) -------------------------------------------

# Loopback only: 127.0.0.0/8 or [::1].
#ATMUSIC_LISTEN=127.2.0.1:8888
# socket | off
#INGEST_MODE=socket
# Absolute paths. The database, backups and uploads default to
# $STATE_DIRECTORY (~/.local/state/atmusic)/{atmusic.db,backups,imports}, the
# admin socket to $XDG_RUNTIME_DIR/atmusic/admin.sock and the web assets to
# <release>/web/dist.
#ATMUSIC_DB=
#ATMUSIC_BACKUP_DIR=
#ATMUSIC_UPLOAD_DIR=
#ATMUSIC_ADMIN_SOCKET=
#ATMUSIC_ASSETS_DIR=
# Socket peers whose client-IP header is honoured.
#ATMUSIC_TRUSTED_PROXIES=127.0.0.0/8,::1
# allowlist | open
#ATMUSIC_SIGNIN_POLICY=allowlist
# Total bytes of pending import uploads (1 GiB), and the free-space floor on
# the state filesystem (2 GiB): below it uploads get 507 and writers pause.
#ATMUSIC_UPLOAD_MAX_BYTES=1073741824
#ATMUSIC_MIN_FREE_BYTES=2147483648
# Upstreams: https, DNS name, default port, ending in /.
#LASTFM_API_ROOT=https://ws.audioscrobbler.com/2.0/
#LASTFM_AUTH_URL=https://www.last.fm/api/auth/
#LISTENBRAINZ_API_ROOT=https://api.listenbrainz.org/
# Public Last.fm client pairs whose request signatures are verified, as
# comma-separated apiKey:sharedSecret:name triples (ADR §7.4).
#ATMUSIC_LASTFM_KNOWN_CLIENTS=panoScrobbler:panoScrobbler:Pano Scrobbler
# 1 appends transition:generic to the OAuth scope (ADR 0004 Q5).
#ATMUSIC_OAUTH_TRANSITION_GENERIC=0
