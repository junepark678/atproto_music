# Copy to .env or a protected service EnvironmentFile. The executable does not
# load this file automatically. CLI flags take precedence over these variables.
ATMUSIC_BIND=127.0.0.1:3000
ATMUSIC_DATABASE_PATH=data/music.sqlite
ATMUSIC_PUBLIC_ORIGIN=https://music.example
# Optional: trust only the socket addresses of your configured reverse proxies.
# ATMUSIC_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Required: generate 32 random bytes and encode them as 64 hexadecimal characters.
# Keep this value stable across restarts and restores; never commit the filled file.
ATMUSIC_ENCRYPTION_KEY=

# Optional: set only after recording ownership of a production NSID namespace.
# Leaving this unset keeps public record publication disabled.
# ATMUSIC_LEXICON_PREFIX=
# ATMUSIC_NAMESPACE_OWNER_DOMAIN=
# ATMUSIC_NAMESPACE_OWNERSHIP_REFERENCE=

# Optional secure relay endpoint. Configuring it does not establish a caught-up index.
# ATMUSIC_RELAY_URL=

RUST_LOG=info

# Separate private metrics listener. Use a stable loopback port for local scraping.
ATMUSIC_METRICS_BIND=127.0.0.1:0
# Required for a non-loopback bind: generate a separate random 32-byte hex token.
# ATMUSIC_METRICS_TOKEN=

# Optional explicit proxy trust, comma-separated CIDRs for controlled proxy hops only.
# ATMUSIC_TRUSTED_PROXY_CIDRS=
