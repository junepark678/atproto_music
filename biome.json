{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "*.ts",
      "*.json",
      "packages/**",
      "worker/**",
      "web/**",
      "scripts/**/*.ts",
      "!**/node_modules",
      "!**/.tsbuild",
      "!**/dist",
      "!**/.wrangler",
      "!package-lock.json",
      "!web/public/oauth/client-metadata.json",
      "!packages/core/data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "json": {
    "formatter": { "trailingCommas": "none" },
    "parser": { "allowComments": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
