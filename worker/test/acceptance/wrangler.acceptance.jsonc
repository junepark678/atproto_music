// Test-only Worker for worker/vitest.acceptance.config.ts (W6-01). Never deployed.
// The production Worker handlers with INDEX bound to TestIndexDO (the
// production IndexDO with test dependencies, entry.ts) and PROD_INDEX bound to
// the unmodified production IndexDO class, which must refuse this environment.
// The fixture prefix com.example.atmusic (never published, ADR 0004 §15) is
// accepted only by TestIndexDO, and only because ACCEPTANCE_ALLOW_FIXTURE_PREFIX
// is set here: worker/src never reads that variable.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "atmusic-acceptance",
  "main": "./entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "INDEX", "class_name": "TestIndexDO" }, { "name": "PROD_INDEX", "class_name": "IndexDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestIndexDO", "IndexDO"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://music.example.test",
    "LEXICON_PREFIX": "com.example.atmusic",
    "ACCEPTANCE_ALLOW_FIXTURE_PREFIX": "true",
    "NAMESPACE_OWNERSHIP_REF": "",
    // Shared fixture through the real ingestion path: the fake Jetstream socket.
    "INGEST_MODE": "socket",
    "JETSTREAM_URLS": "wss://jetstream.example.test",
    "JETSTREAM_LOOKBACK_HOURS": "24",
    "RELAY_URL": "https://relay.example.test",
    "PLAN": "paid",
    "DO_LOCATION_HINT": "",
    // Test-only key material (32 bytes); never a production secret.
    "CURSOR_KEY": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
  }
}
