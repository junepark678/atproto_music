{
  // Test suites use Node types and Vite's client declarations for ?raw imports.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["**/*.ts"],
  "exclude": [".tsbuild"],
  "references": [{ "path": ".." }, { "path": "../../packages/core" }, { "path": "../../packages/atproto" }]
}
