// Test-only Worker for worker/vitest.composition.config.ts (W5-01): the
// production Worker handlers with INDEX bound to TestIndexDO, the production
// IndexDO with test dependencies (entry.ts). Never deployed. The fixture
// prefix is accepted only because TestIndexDO passes `allowFixturePrefix`.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "atmusic-composition",
  "main": "./entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "INDEX", "class_name": "TestIndexDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestIndexDO"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://music.example.test",
    "LEXICON_PREFIX": "com.example.atmusic",
    "NAMESPACE_OWNERSHIP_REF": "",
    "INGEST_MODE": "off",
    "JETSTREAM_URLS": "wss://jetstream.example.test",
    "JETSTREAM_LOOKBACK_HOURS": "24",
    "RELAY_URL": "https://relay.example.test",
    "PLAN": "paid",
    "DO_LOCATION_HINT": "",
    // Test-only key material (32 bytes); never a production secret.
    "CURSOR_KEY": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
  }
}
