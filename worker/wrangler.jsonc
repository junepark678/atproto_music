// atmusic production Worker (ADR 0004 §4.2). One Worker, one SQLite Durable
// Object (IndexDO, a single instance from idFromName("index-v1")), Static
// Assets for the SPA, one cron, one required secret.
//
// Secrets (never in this file): `wrangler secret put CURSOR_KEY` (required,
// `openssl rand -hex 32`) and optionally `wrangler secret put ADMIN_TOKEN`.
// Local development reads them from worker/.dev.vars (see .dev.vars.example).
//
// Origin and prefix are the owner's decision recorded in ADR §15 Q3
// (2026-10-24): production serves https://music.214510.xyz (zone 214510.xyz),
// so the OAuth client_id is https://music.214510.xyz/oauth/client-metadata.json
// and must never change once users sign in. The lexicon prefix is
// dev.pythonplayer123.music (NSID authority music.pythonplayer123.dev).
//
// NAMESPACE_OWNERSHIP_REF stays empty until the ownership-evidence step is
// done: publish the `_lexicon.music.pythonplayer123.dev` TXT record in zone
// pythonplayer123.dev and record a reviewable reference to it. Until then
// parseConfig reports publication=false (no writes) while ingestion of the
// decided collections runs. The free and staging hostnames are subdomains of
// the owner's zone chosen here, not owner-decided values; change them before
// first sign-in on those environments if the owner prefers others.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "atmusic",
  "main": "src/index.ts",
  // >= 2025-04-01 so navigation requests prefer assets.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /oauth/* is deliberately absent: /oauth/callback is an SPA route.
    "run_worker_first": ["/api/*", "/health/*", "/internal/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "INDEX", "class_name": "IndexDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IndexDO"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  // Workers Paid only; env.free and env.staging clear it.
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_ORIGIN": "https://music.214510.xyz",
    // Owned, non-fixture prefix (ADR §15 Q3). Empty would close the namespace
    // gate (ingestion and publication disabled).
    "LEXICON_PREFIX": "dev.pythonplayer123.music",
    // Empty until the _lexicon TXT ownership evidence exists: no publication.
    "NAMESPACE_OWNERSHIP_REF": "",
    // socket | pulse | off
    "INGEST_MODE": "socket",
    "JETSTREAM_URLS": "wss://jetstream.us-east.bsky.network,wss://jetstream.us-west.bsky.network",
    // Conservative; Jetstream documents its lookback only as "bounded".
    "JETSTREAM_LOOKBACK_HOURS": "24",
    "RELAY_URL": "https://relay1.us-east.bsky.network",
    // paid | free: selects the per-alarm slice budgets.
    "PLAN": "paid",
    "DO_LOCATION_HINT": "enam"
  },
  // A custom domain on an owned zone is mandatory: the OAuth client_id
  // (https://<host>/oauth/client-metadata.json) must never change.
  "routes": [{ "pattern": "music.214510.xyz", "custom_domain": true }],
  "env": {
    // Free plan: dev and private hobby use. durable_objects and vars are not
    // inheritable, so both are re-declared; no CPU limit override.
    "free": {
      "durable_objects": {
        "bindings": [{ "name": "INDEX", "class_name": "IndexDO" }]
      },
      "limits": {},
      "vars": {
        "PUBLIC_ORIGIN": "https://music-free.214510.xyz",
        "LEXICON_PREFIX": "dev.pythonplayer123.music",
        "NAMESPACE_OWNERSHIP_REF": "",
        "INGEST_MODE": "pulse",
        "JETSTREAM_URLS": "wss://jetstream.us-east.bsky.network,wss://jetstream.us-west.bsky.network",
        "JETSTREAM_LOOKBACK_HOURS": "24",
        "RELAY_URL": "https://relay1.us-east.bsky.network",
        "PLAN": "free",
        "DO_LOCATION_HINT": "enam"
      },
      "routes": [{ "pattern": "music-free.214510.xyz", "custom_domain": true }]
    },
    // Staging: its own hostname (so its own OAuth client_id) and, as a
    // separate Worker (atmusic-staging), its own DO namespace.
    "staging": {
      "durable_objects": {
        "bindings": [{ "name": "INDEX", "class_name": "IndexDO" }]
      },
      "limits": {},
      "vars": {
        "PUBLIC_ORIGIN": "https://music-staging.214510.xyz",
        "LEXICON_PREFIX": "dev.pythonplayer123.music",
        "NAMESPACE_OWNERSHIP_REF": "",
        "INGEST_MODE": "pulse",
        "JETSTREAM_URLS": "wss://jetstream.us-east.bsky.network,wss://jetstream.us-west.bsky.network",
        "JETSTREAM_LOOKBACK_HOURS": "24",
        "RELAY_URL": "https://relay1.us-east.bsky.network",
        "PLAN": "free",
        "DO_LOCATION_HINT": "enam"
      },
      "routes": [{ "pattern": "music-staging.214510.xyz", "custom_domain": true }]
    }
  }
}
