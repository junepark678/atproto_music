{
  // The Worker and IndexDO, production sources only: Workers runtime types.
  // The test suites are a separate project (test/tsconfig.json), so test-only
  // declarations (the harness's Cloudflare.Env augmentation, cloudflare:test
  // and Vite's client types) never reach this typecheck.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild",
    "lib": ["es2024"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../packages/core" }, { "path": "../packages/atproto" }]
}
